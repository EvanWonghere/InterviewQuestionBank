{
  "name": "interview-question-bank",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate:questions": "node scripts/migrate-legacy-questions.mjs",
    "preview": "vite preview",
    "preview:quiz": "npm run build && rm -rf dist-preview && mkdir -p dist-preview/quiz && cp -r dist/. dist-preview/quiz && serve dist-preview -l 4173",
    "test:ai-db": "node scripts/test-ai-db.mjs",
    "test:ai-edge": "deno test --allow-env --allow-net --allow-read --allow-sys supabase/functions/ai-tutor/handler_test.js supabase/functions/ai-tutor/labs_test.ts supabase/functions/ai-tutor/music_test.ts supabase/functions/ai-tutor/musicArrange_test.ts",
    "test:ai-e2e": "playwright test --config playwright.ai.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "mermaid": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.5.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
